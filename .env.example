# Copy to .env.local and fill in what you need. Never commit real keys.

# Projects API used by the public site (defaults to the Render deployment).
# VITE_API_URL=https://portfolio-server-raue.onrender.com

# --- /addprojects admin tool (local use only) ---
# API that accepts POST /projects (defaults to http://localhost:5000).
# VITE_ADMIN_API_URL=http://localhost:5000
# imgbb API key used to host project screenshots: https://api.imgbb.com/
VITE_IMGBB_API_KEY=
